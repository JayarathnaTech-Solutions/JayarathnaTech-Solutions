rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // `staff` doc id is the person's email, not their uid — invites are created
    // by email before the invitee has ever signed in (no Cloud Functions means
    // no server-side step to reconcile a uid after the fact).
    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.token.email));
    }

    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/staff/$(request.auth.token.email)).data.role == 'admin';
    }

    function isDeveloper() {
      return request.auth != null
        && get(/databases/$(database)/documents/staff/$(request.auth.token.email)).data.role == 'developer';
    }

    // Same one-function-per-role shape as isAdmin()/isDeveloper() above —
    // see the comment near isEngagementAssignee() for why this file avoids
    // a single generic "resolved role" helper.
    function isHr() {
      return request.auth != null
        && get(/databases/$(database)/documents/staff/$(request.auth.token.email)).data.role == 'hr';
    }

    function isQa() {
      return request.auth != null
        && get(/databases/$(database)/documents/staff/$(request.auth.token.email)).data.role == 'qa';
    }

    function isIntern() {
      return request.auth != null
        && get(/databases/$(database)/documents/staff/$(request.auth.token.email)).data.role == 'intern';
    }

    function isUiux() {
      return request.auth != null
        && get(/databases/$(database)/documents/staff/$(request.auth.token.email)).data.role == 'uiux';
    }

    // A customer can authenticate before verifying their email (Firebase's
    // email/password sign-in doesn't block it), but must not be able to write
    // anything customer-scoped until they do — there's no server here to
    // double-check, so this has to be enforced in rules, not just the app's UI.
    function isVerifiedCustomer() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/customers/$(request.auth.uid));
    }

    // Rules can't run `where` queries, so the payment gates below rely on the
    // engagement doc knowing exactly which invoice doc to check.
    function invoiceVerified(invoiceId) {
      return invoiceId != ''
        && get(/databases/$(database)/documents/invoices/$(invoiceId)).data.status == 'verified';
    }

    // Only two forward transitions exist, each gated on its invoice being
    // verified; same-status writes (editing other fields) are always fine.
    function engagementStatusTransitionAllowed() {
      return request.resource.data.status == resource.data.status
        || (resource.data.status == 'pending_advance'
          && request.resource.data.status == 'in_progress'
          && invoiceVerified(resource.data.advanceInvoiceId))
        || (resource.data.status == 'in_progress'
          && request.resource.data.status == 'delivered'
          && invoiceVerified(resource.data.finalInvoiceId));
    }

    // advanceInvoiceId/finalInvoiceId are set together, once, when the
    // contract value is set — after that they must never change, since the
    // status-transition gates above trust them completely.
    function engagementInvoicePointersLocked() {
      return resource.data.advanceInvoiceId == ''
        || (request.resource.data.advanceInvoiceId == resource.data.advanceInvoiceId
          && request.resource.data.finalInvoiceId == resource.data.finalInvoiceId);
    }

    // Split into one function per role (rather than a single function
    // returning the resolved role as a string) — an earlier version using a
    // nested ternary returning 'admin'/'developer'/'customer'/null tripped a
    // "Null value error" in the rules evaluator; this boolean-per-branch
    // form is the same shape as the rest of this file and is proven to work.
    // developer/qa/intern are all "assigned to the engagement" roles — same
    // assignedDeveloperEmails list, same access, just three different job
    // titles — so this composes the three booleans rather than adding a
    // third near-identical isEngagement*() function per new role.
    function isAssignedToEngagement(assignedEmails) {
      return (isDeveloper() || isQa() || isIntern() || isUiux())
        && request.auth.token.email in assignedEmails;
    }
    function isEngagementAssignee(engagementId) {
      let eng = get(/databases/$(database)/documents/engagements/$(engagementId)).data;
      return isAssignedToEngagement(eng.assignedDeveloperEmails);
    }
    function isEngagementCustomer(engagementId) {
      let eng = get(/databases/$(database)/documents/engagements/$(engagementId)).data;
      return isVerifiedCustomer() && request.auth.uid == eng.customerId;
    }
    function engagementParticipant(engagementId) {
      return isAdmin() || isEngagementAssignee(engagementId) || isEngagementCustomer(engagementId);
    }

    // Blocks `javascript:`/`data:`/etc. URIs from being stored in fields the
    // UI renders as an `href`/`src` (invoice payment proof, chat
    // attachments) — the app only ever writes Cloudinary HTTPS URLs here,
    // but that's a client-side convention, not something rules can trust;
    // this is the actual enforcement.
    function isHttpsUrl(url) {
      return url is string && url.matches('^https://.*');
    }

    // Mirrors the staff/{staffId} HR-vs-admin-target guard above, for rules
    // (staffRecords) keyed by staffId rather than by the caller's own doc.
    function targetIsAdmin(staffId) {
      return get(/databases/$(database)/documents/staff/$(staffId)).data.role == 'admin';
    }

    match /staff/{staffId} {
      allow get: if request.auth != null && request.auth.token.email == staffId;
      allow list: if isAdmin() || isHr();
      // Admin has no target-role restriction. HR gets the same create/update/
      // delete powers, EXCEPT it can never touch an admin account: not the
      // existing doc (resource.data.role), not the incoming one (promoting
      // someone to admin), so HR can't edit/delete admins or self-promote.
      // Neither role can change their OWN role — otherwise a self-demotion
      // (accidental or not) can lock an admin/hr account out with no other
      // staff member around to undo it; self can still rename via the
      // dedicated name-only rule below.
      allow create, update: if isAdmin()
        && request.resource.data.role in ['admin', 'editor', 'developer', 'hr', 'qa', 'intern', 'uiux']
        && request.auth.token.email != staffId;
      allow create, update: if isHr()
        && (resource == null || resource.data.role != 'admin')
        && request.resource.data.role in ['editor', 'developer', 'hr', 'qa', 'intern', 'uiux']
        && request.auth.token.email != staffId;
      allow update: if request.auth.token.email == staffId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
      allow delete: if isAdmin();
      allow delete: if isHr() && resource.data.role != 'admin';
    }

    // Sensitive personal data (NIC, birthday, address, phones, NIC scans),
    // deliberately kept out of `staff` above so it never rides along with
    // the isAdmin()/isStaff() lookups every other rule in this file does —
    // only admin/hr can read or write any of it.
    match /staffRecords/{staffId} {
      // HR can never read or write an admin's personal info, same boundary
      // as the staff/{staffId} rules above.
      allow list: if isAdmin() || isHr();
      allow get: if isAdmin() || (isHr() && !targetIsAdmin(staffId));
      // `resource.data` doesn't exist yet on create (no doc to diff against),
      // so create validates the incoming keys directly; update diffs against
      // the existing doc — same allowlist, two different Firestore APIs.
      allow create: if (isAdmin() || (isHr() && !targetIsAdmin(staffId)))
        && request.resource.data.keys()
             .hasOnly(['nic', 'birthday', 'address', 'phone1', 'phone2', 'nicFrontUrl', 'nicBackUrl', 'updatedAt', 'updatedBy'])
        && (!('nicFrontUrl' in request.resource.data) || request.resource.data.nicFrontUrl == '' || isHttpsUrl(request.resource.data.nicFrontUrl))
        && (!('nicBackUrl' in request.resource.data) || request.resource.data.nicBackUrl == '' || isHttpsUrl(request.resource.data.nicBackUrl));
      allow update: if (isAdmin() || (isHr() && !targetIsAdmin(staffId)))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['nic', 'birthday', 'address', 'phone1', 'phone2', 'nicFrontUrl', 'nicBackUrl', 'updatedAt', 'updatedBy'])
        && (!('nicFrontUrl' in request.resource.data) || request.resource.data.nicFrontUrl == '' || isHttpsUrl(request.resource.data.nicFrontUrl))
        && (!('nicBackUrl' in request.resource.data) || request.resource.data.nicBackUrl == '' || isHttpsUrl(request.resource.data.nicBackUrl));
      allow delete: if isAdmin() || (isHr() && !targetIsAdmin(staffId));
    }

    // `customers` doc id is the Auth uid, not email — unlike `staff` invites,
    // a customer's uid is already known at the moment the admin action that
    // creates them runs (see src/lib/customerProvisioning.ts), so there's no
    // need for an email-keyed lookup-before-signin workaround here.
    match /customers/{uid} {
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      // Customer self-service is limited to clearing mustChangePassword after
      // a forced first-login password change, and editing their own name.
      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword', 'name']));
    }

    // Single global doc (settings/bankDetails) — any signed-in staff or
    // customer can read it (it's shown on every bank-transfer invoice), only
    // admin can change it.
    match /settings/{settingId} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // A customer's paid engagement — distinct from the public `projects`
    // portfolio above. Never written by customers or developers: every
    // status change funnels through the payment gates above.
    match /engagements/{engagementId} {
      allow get: if isAdmin()
        || isAssignedToEngagement(resource.data.assignedDeveloperEmails)
        || (request.auth != null && request.auth.uid == resource.data.customerId);

      // Split per role so each branch is provable against its own query
      // filter (an unfiltered `list` only ever succeeds for admin).
      allow list: if isAdmin();
      allow list: if isAssignedToEngagement(resource.data.assignedDeveloperEmails);
      allow list: if request.auth != null && request.auth.uid == resource.data.customerId;

      allow create: if isAdmin()
        && request.resource.data.status == 'pending_advance'
        && request.resource.data.advanceInvoiceId == ''
        && request.resource.data.finalInvoiceId == '';

      allow update: if isAdmin()
        && engagementStatusTransitionAllowed()
        && engagementInvoicePointersLocked();

      allow delete: if isAdmin();
    }

    // Advance/final invoices for an engagement. `create` is always
    // admin-triggered (never customer-initiated); a customer may only ever
    // move a pending bank-transfer invoice to `proof_submitted` — they can
    // never write `status: 'verified'` themselves, and a verified invoice
    // becomes fully immutable to them.
    match /invoices/{invoiceId} {
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.customerId);
      allow list: if isAdmin();
      allow list: if request.auth != null && request.auth.uid == resource.data.customerId;

      allow create: if isAdmin()
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['advance', 'final'];

      allow update: if isAdmin()
        || (
          request.auth != null
          && request.auth.uid == resource.data.customerId
          && resource.data.status != 'verified'
          && resource.data.paymentMethod == 'bank_transfer'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proofUrl', 'status', 'proofSubmittedAt'])
          && request.resource.data.status == 'proof_submitted'
          && isHttpsUrl(request.resource.data.proofUrl)
        );

      allow delete: if false;
    }

    // One chat thread per engagement; immutable log once posted.
    match /engagements/{engagementId}/messages/{messageId} {
      allow get, list: if engagementParticipant(engagementId);

      // senderRole is pinned to whichever branch actually authorized the
      // caller — a participant can't claim a higher-trust role than they
      // actually have (e.g. a customer posting as senderRole: 'admin').
      allow create: if (
          (isAdmin() && request.resource.data.senderRole == 'admin')
          // qa/intern are assignees too, and post under the same
          // 'developer' senderRole tag — see EngagementDetail.tsx's
          // senderRole mapping for the client-side half of this.
          || (isEngagementAssignee(engagementId) && request.resource.data.senderRole == 'developer')
          || (isEngagementCustomer(engagementId) && request.resource.data.senderRole == 'customer')
        )
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderEmail == request.auth.token.email
        && (request.resource.data.text is string || isHttpsUrl(request.resource.data.attachmentUrl))
        && (!('text' in request.resource.data) || request.resource.data.text.size() <= 4000);

      allow update, delete: if false;
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    // Client/partner logos shown in the "Trusted by" strip on the homepage.
    match /companies/{companyId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    match /quotes/{quoteId} {
      allow read, create, update, delete: if isStaff();
    }

    match /contactMessages/{messageId} {
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.read == false;
      allow read, update, delete: if isStaff();
    }

    match /testimonials/{testimonialId} {
      allow read: if resource.data.status == 'approved' || isStaff();
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.clientName is string
        && request.resource.data.clientName.size() > 0
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && (!('rating' in request.resource.data)
          || (request.resource.data.rating is number
            && request.resource.data.rating >= 1
            && request.resource.data.rating <= 5));
      allow update, delete: if isStaff();
    }

    // Doc id doubles as the invite token — public `get`-by-exact-id only, no
    // `list`, so a token can't be discovered by enumeration.
    match /testimonialInvites/{inviteId} {
      allow get: if true;
      allow list: if isStaff();
      allow create: if isStaff();
      allow update: if resource.data.used == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used'])
        && request.resource.data.used == true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
