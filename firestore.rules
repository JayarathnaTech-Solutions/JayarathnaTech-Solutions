rules_version = '2';

// Placeholder: only public read on `projects`/`testimonials` is open (needed by
// the public site's Home/Projects pages). Everything else denied by default.
// Full per-collection rules (staff writes, invite tokens, etc.) land in
// PLAN.md step 8 — do not treat this as the final security posture.
service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    match /staff/{staffId} {
      allow get: if request.auth != null && request.auth.uid == staffId;
    }

    match /projects/{projectId} {
      allow read: if true;
    }

    match /quotes/{quoteId} {
      allow read: if isStaff();
    }

    match /contactMessages/{messageId} {
      allow read: if isStaff();
    }

    match /testimonials/{testimonialId} {
      allow read: if resource.data.status == 'approved' || isStaff();
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.clientName is string
        && request.resource.data.clientName.size() > 0
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && (!('rating' in request.resource.data)
          || (request.resource.data.rating is number
            && request.resource.data.rating >= 1
            && request.resource.data.rating <= 5));
    }

    // Doc id doubles as the invite token — public `get`-by-exact-id only, no
    // `list`, so a token can't be discovered by enumeration.
    match /testimonialInvites/{inviteId} {
      allow get: if true;
      allow update: if resource.data.used == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used'])
        && request.resource.data.used == true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
