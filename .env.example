# Firebase web app config (Project Settings > General > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to connect the app to the local Firebase Emulator Suite
# (run `npm run emulators` in another terminal first)
VITE_USE_FIREBASE_EMULATORS=true

# Cloudinary (unsigned client-side uploads — see PLAN.md step 10)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
