# Firebase web app config (Project Settings > General > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to connect the app to the local Firebase Emulator Suite
# (run `npm run emulators` in another terminal first)
VITE_USE_FIREBASE_EMULATORS=true

# Cloudinary (unsigned client-side uploads — see PLAN.md step 10)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
# Separate preset/folder for payment receipts and chat attachments — keeps
# sensitive customer uploads out of the public project-images preset above.
VITE_CLOUDINARY_RECEIPTS_UPLOAD_PRESET=
# Separate preset/folder for staff NIC images — keeps this PII out of the
# public/receipts presets above.
VITE_CLOUDINARY_NIC_UPLOAD_PRESET=

# Web3Forms (contact form submission — public access key, safe for client-side code)
VITE_WEB3FORMS_ACCESS_KEY=

# Google Analytics 4 (only loaded in production builds — see src/lib/analytics.ts)
VITE_GA_MEASUREMENT_ID=

# Gemini API key for the site chat assistant (api/chat.ts). No VITE_ prefix —
# this must stay server-side only, never exposed to the client bundle.
GEMINI_API_KEY=
